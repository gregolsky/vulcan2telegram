# Copy to .env (chmod 600) and fill in. .env is git-ignored; never commit real values.
VULCAN_USERNAME=
VULCAN_PASSWORD=
VULCAN_URL=
# school unit id: the number after the symbol in the portal's Uczeń URL (e.g. 001234)
VULCAN_SCHOOL_UNIT_ID=

TELEGRAM_BOT_TOKEN=
# supergroup id, e.g. -1001234567890
TELEGRAM_CHAT_ID=
# topic (message_thread_id) inside the supergroup
# one topic per module (message_thread_id); grades/exams/plan stay off until their topic is set
# inbox ("Wiadomości z dziennika")
TELEGRAM_THREAD_ID=
# "Oceny"
TELEGRAM_THREAD_GRADES=
# "Sprawdziany"
TELEGRAM_THREAD_EXAMS=
# "Zmiany w planie"
TELEGRAM_THREAD_PLAN=

# optional
# how many weeks ahead to look for tests
# EXAMS_WEEKS=4
# STATE_FILE=./state.json
# MAX_PER_RUN=20
# Docker only: seconds between runs (default 1200)
# RUN_INTERVAL=1200
# on the Pi, if the bundled Chromium does not run
# CHROMIUM_PATH=/usr/bin/chromium
